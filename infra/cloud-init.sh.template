#!/usr/bin/env bash
#
# Droplet first-boot script. Rendered from this template by
# infra/bootstrap-do.sh — placeholders like __OE_DOMAIN__ are replaced
# before the script is uploaded as the Droplet's user-data.
#
# Runs once, as root, the first time the Droplet boots. Logs to
# /var/log/cloud-init-output.log.

set -euo pipefail
exec > >(tee -a /var/log/openemr-bootstrap.log) 2>&1
echo "[bootstrap] starting at $(date -Iseconds)"

# ---------------------------------------------------------------------------
# 1. System packages
# ---------------------------------------------------------------------------

export DEBIAN_FRONTEND=noninteractive
apt-get update -y
apt-get install -y \
    ca-certificates \
    curl \
    git \
    gnupg \
    ufw

# ---------------------------------------------------------------------------
# 2. Docker engine + compose plugin (Docker's official apt repo)
# ---------------------------------------------------------------------------
# Idempotent: only re-installs the GPG key and apt source if missing.

install -m 0755 -d /etc/apt/keyrings

if [[ ! -s /etc/apt/keyrings/docker.gpg ]]; then
    # `gpg --batch --yes` avoids reading from /dev/tty when re-running
    # this script from a non-interactive ssh session.
    curl -fsSL https://download.docker.com/linux/ubuntu/gpg \
        | gpg --batch --yes --dearmor -o /etc/apt/keyrings/docker.gpg
    chmod a+r /etc/apt/keyrings/docker.gpg
fi

# shellcheck source=/dev/null
. /etc/os-release
DOCKER_LIST=/etc/apt/sources.list.d/docker.list
if [[ ! -s "${DOCKER_LIST}" ]]; then
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] \
        https://download.docker.com/linux/ubuntu ${VERSION_CODENAME} stable" \
        > "${DOCKER_LIST}"
fi

apt-get update -y
apt-get install -y \
    docker-ce \
    docker-ce-cli \
    containerd.io \
    docker-buildx-plugin \
    docker-compose-plugin

systemctl enable --now docker

# ---------------------------------------------------------------------------
# 3. Firewall — only 22/80/443 open
# ---------------------------------------------------------------------------

ufw default deny incoming
ufw default allow outgoing
ufw allow 22/tcp
ufw allow 80/tcp
ufw allow 443/tcp
ufw --force enable

# ---------------------------------------------------------------------------
# 4. Install gitlab-runner (deploys run on the Droplet itself)
# ---------------------------------------------------------------------------

if ! command -v gitlab-runner > /dev/null; then
    curl -L "https://packages.gitlab.com/install/repositories/runner/gitlab-runner/script.deb.sh" | bash
    apt-get install -y gitlab-runner
fi

# Let gitlab-runner drive docker compose. Group membership applies to
# new processes; the systemd restart later picks it up.
usermod -aG docker gitlab-runner

# ---------------------------------------------------------------------------
# 5. Layout (releases, config, bare repo)
# ---------------------------------------------------------------------------
# /srv/openemr/   runner-owned. Releases and the active-release symlink.
# /etc/openemr/   runner-owned. compose project + .env. Outside any
#                 bind-mount so the container can never chown it.

mkdir -p /srv/openemr/releases /etc/openemr
chown -R gitlab-runner:gitlab-runner /srv/openemr /etc/openemr

REPO_URL='https://__GITLAB_DEPLOY_TOKEN_NAME__:__GITLAB_DEPLOY_TOKEN_VALUE__@__GITLAB_HOST__/__GITLAB_REPO_PATH__.git'
REPO_BRANCH='__GITLAB_BRANCH__'
REPO_GIT=/srv/openemr/repo.git

if [[ ! -d "${REPO_GIT}" ]]; then
    echo "[bootstrap] mirroring ${REPO_URL} into ${REPO_GIT}"
    sudo -u gitlab-runner git clone --mirror "${REPO_URL}" "${REPO_GIT}"
fi

# Initial release: clone from the bare mirror into a release dir, then
# symlink current → it. Subsequent deploys reuse this layout via
# infra/runner-bootstrap.sh.
INITIAL_SHA=$(sudo -u gitlab-runner git -C "${REPO_GIT}" rev-parse "${REPO_BRANCH}")
INITIAL_RELEASE="/srv/openemr/releases/${INITIAL_SHA}"
if [[ ! -d "${INITIAL_RELEASE}" ]]; then
    echo "[bootstrap] creating initial release ${INITIAL_SHA}"
    sudo -u gitlab-runner git clone --shared --branch "${REPO_BRANCH}" \
        "${REPO_GIT}" "${INITIAL_RELEASE}"
fi
if [[ ! -L /srv/openemr/current ]]; then
    sudo -u gitlab-runner ln -sfn "${INITIAL_RELEASE}" /srv/openemr/current
fi

# ---------------------------------------------------------------------------
# 6. /etc/openemr/.env (read by docker compose)
# ---------------------------------------------------------------------------

ENV_FILE=/etc/openemr/.env
if [[ ! -f "${ENV_FILE}" ]]; then
    echo "[bootstrap] writing ${ENV_FILE}"
    cat > "${ENV_FILE}" <<EOF
OE_DOMAIN=__OE_DOMAIN__
APEX_DOMAIN=__APEX_DOMAIN__
OE_USER=admin
OE_PASS=__OE_PASS__
MYSQL_ROOT_PASSWORD=__MYSQL_ROOT_PASSWORD__
EOF
    chown gitlab-runner:gitlab-runner "${ENV_FILE}"
    chmod 600 "${ENV_FILE}"
else
    echo "[bootstrap] ${ENV_FILE} already exists, leaving it alone"
fi

# Seed compose config from the initial release. Future deploys overwrite
# these via infra/deploy.sh, but they need to exist for the very first
# `docker compose up` below.
install -D -m 0644 -o gitlab-runner -g gitlab-runner \
    "${INITIAL_RELEASE}/docker/digitalocean/docker-compose.yml" \
    /etc/openemr/docker-compose.yml
install -D -m 0644 -o gitlab-runner -g gitlab-runner \
    "${INITIAL_RELEASE}/docker/digitalocean/Caddyfile" \
    /etc/openemr/Caddyfile

# ---------------------------------------------------------------------------
# 6b. Static apex landing page directory
# ---------------------------------------------------------------------------
# Caddy bind-mounts /opt/site into the container to serve the apex
# landing page. The actual HTML lives on the Droplet only — not in
# version control. If empty, Caddy will return 404 for the apex.
mkdir -p /opt/site

# ---------------------------------------------------------------------------
# 7. Bring up the stack and start the runner
# ---------------------------------------------------------------------------

cd /etc/openemr
docker compose pull
docker compose up -d

# gitlab-runner registration is interactive (needs a token from the UI),
# so cloud-init can't fully automate it. Restart the service so the
# docker group membership takes effect, then leave registration as a
# one-time manual step (documented in infra/README.md).
systemctl restart gitlab-runner

echo "[bootstrap] complete at $(date -Iseconds)"
echo "[bootstrap] OpenEMR will be reachable at https://__OE_DOMAIN__/ once"
echo "[bootstrap] DNS resolves and Caddy has fetched a cert."
echo "[bootstrap] Register the runner: see infra/README.md"
