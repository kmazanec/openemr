# Dashboard SPA build/runtime config. Real values go in
# `.env.local` (git-ignored) for dev, and in the deploy environment
# for prod. See `dashboard/README.md` for the OAuth2 client
# registration step that produces the client_id.

# Base URL the SPA is served from. Vite reads this to rewrite asset
# paths. Default `/` is correct for `npm run dev`; production builds
# under Apache mount at `/dashboard/` (set during T1.6).
VITE_BASE=/

# OIDC / SMART-on-FHIR auth surface. Read at app startup by
# `src/lib/fhir.ts` (getOidcConfig). Every var is required — the
# helper throws a descriptive error if any is missing or empty.
#
# - VITE_OIDC_ISSUER: the **FHIR base URL** that fhirclient uses for
#   SMART discovery. fhirclient calls
#   `{iss}/.well-known/smart-configuration` and `{iss}/metadata`
#   (CapabilityStatement) at startup; the OAuth authorize/token
#   endpoints are read from the smart-configuration response, not
#   computed from this URL. For the dev docker-compose stack:
#   https://localhost:9300/apis/default/fhir.
# - VITE_OIDC_CLIENT_ID: returned by the one-time
#   `POST /oauth2/{site}/registration` step. See dashboard/README.md.
# - VITE_OIDC_REDIRECT_URI: must match the redirect URI registered
#   with the client. For dev: http://localhost:5173/auth/callback.
#   For prod: https://emr.example.com/dashboard/auth/callback.
# - VITE_OIDC_SCOPE: space-separated SMART scopes. The set below is
#   what the W2 cards need that the OpenEMR FHIR server actually
#   supports; `patient/MedicationStatement.read` is intentionally
#   omitted because it is not exposed by the server (T4.4 will need
#   to source medications differently).
VITE_OIDC_ISSUER=https://localhost:9300/apis/default/fhir
VITE_OIDC_CLIENT_ID=
VITE_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_OIDC_SCOPE=openid fhirUser launch/patient offline_access patient/Patient.read patient/AllergyIntolerance.read patient/Condition.read patient/MedicationRequest.read patient/CareTeam.read patient/Encounter.read
