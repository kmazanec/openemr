{
  "name": "@openemr/clinical-copilot-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Clinical Co-Pilot agent service: LangGraph runtime that produces source-cited briefings for OpenEMR.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "start": "node --enable-source-maps dist/server/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "evals:regenerate-fixtures": "tsx evals/fixtures/regenerate.ts",
    "evals:upload-dataset": "tsx --env-file-if-exists=.env evals/runners/cli.ts upload-dataset",
    "evals:experiment": "tsx --env-file-if-exists=.env evals/runners/cli.ts experiment",
    "evals:rebaseline": "tsx --env-file-if-exists=.env scripts/rebaseline.ts",
    "corpus:fetch:uspstf": "tsx scripts/fetch-uspstf-corpus.ts",
    "corpus:extract:uspstf": "tsx scripts/extract-uspstf-corpus.ts",
    "corpus:fetch:cdc": "tsx scripts/fetch-cdc-corpus.ts",
    "corpus:extract:cdc": "tsx scripts/extract-cdc-corpus.ts",
    "corpus:fetch:ada": "tsx scripts/fetch-ada-corpus.ts",
    "corpus:extract:ada": "tsx scripts/extract-ada-corpus.ts",
    "corpus:fetch:ags-beers": "tsx scripts/fetch-ags-beers-corpus.ts",
    "corpus:extract:ags-beers": "tsx scripts/extract-ags-beers-corpus.ts",
    "grounding:reindex-corpus": "tsx --env-file-if-exists=.env scripts/reindex-corpus.ts",
    "probe:evidence-retriever": "tsx --env-file-if-exists=.env scripts/probe-evidence-retriever.ts",
    "migrate": "node-pg-migrate --envPath .env --migrations-dir migrations --database-url-var DATABASE_URL",
    "migrate:up": "npm run migrate -- up",
    "migrate:down": "npm run migrate -- down",
    "migrate:create": "npm run migrate -- create"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1043.0",
    "@aws-sdk/s3-request-presigner": "3.1043.0",
    "@hono/node-server": "1.19.7",
    "@langchain/anthropic": "1.3.28",
    "@langchain/core": "1.1.42",
    "@langchain/langgraph": "1.2.9",
    "@langchain/langgraph-checkpoint-postgres": "1.0.1",
    "@pinecone-database/pinecone": "7.2.0",
    "cheerio": "1.2.0",
    "gray-matter": "4.0.3",
    "hono": "4.12.15",
    "jose": "5.10.0",
    "langsmith": "0.5.26",
    "natural": "8.1.1",
    "node-pg-migrate": "8.0.4",
    "openai": "6.36.0",
    "pg": "8.20.0",
    "pino": "10.3.1",
    "zod": "4.4.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/natural": "5.1.5",
    "@types/node": "22.18.0",
    "@types/pg": "8.20.0",
    "eslint": "10.2.1",
    "pino-pretty": "13.1.3",
    "prettier": "3.8.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.1",
    "vitest": "4.1.5"
  }
}
