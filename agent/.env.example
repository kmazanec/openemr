# Local-only secrets for the §3.6 LangSmith eval runners. Copy to
# `agent/.env` (gitignored) and fill in real values. Both keys are
# optional — the runners no-op with a structured `skippedReason` when
# either is unset, so an empty .env is harmless.
#
# Loaded via `tsx --env-file-if-exists=.env` in the npm scripts:
#   - npm run evals:upload-dataset
#   - npm run evals:experiment
#
# CI sets these as masked GitLab CI/CD variables instead — see
# `test:agent-evals-nightly` in `.gitlab-ci.yml`.

# Required for `evals:experiment` (drives the real Anthropic synthesizer
# against the dataset).
ANTHROPIC_API_KEY=

# Required for both `evals:upload-dataset` and `evals:experiment`
# (the eval runners post examples + experiments to LangSmith).
LANGSMITH_API_KEY=

# Optional. If unset, LangSmith uses the workspace default project.
LANGSMITH_PROJECT=clinical-copilot
