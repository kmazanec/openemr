# Local-only secrets for the §3.6 LangSmith eval runners. Copy to
# `agent/.env` (gitignored) and fill in real values. Both keys are
# optional — the runners no-op with a structured `skippedReason` when
# either is unset, so an empty .env is harmless.
#
# Loaded via `tsx --env-file-if-exists=.env` in the npm scripts:
#   - npm run evals:upload-dataset
#   - npm run evals:experiment
#
# CI sets these as masked GitLab CI/CD variables instead — see
# `test:agent-evals-nightly` in `.gitlab-ci.yml`.

# Required for `evals:experiment` (drives the real Anthropic synthesizer
# against the dataset).
ANTHROPIC_API_KEY=

# Required for both `evals:upload-dataset` and `evals:experiment`
# (the eval runners post examples + experiments to LangSmith).
LANGSMITH_API_KEY=

# Optional. If unset, LangSmith uses the workspace default project.
LANGSMITH_PROJECT=clinical-copilot

# §C.0 evidenceRetriever vendor credentials. Required for the
# `corpus:fetch:uspstf` / `corpus:extract:uspstf` / `evals:reindex-corpus`
# scripts and for the running agent's `evidenceRetriever` node.
# Local-only — production reads them from `/etc/openemr/.env` on the
# Droplet.

# Pinecone — hybrid sparse-dense vector store for the guideline corpus.
# Create one serverless hybrid index in your Pinecone account with
# dimension 3072, metric `dotproduct` (required for hybrid sparse-dense),
# then set the index name below.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=

# Optional. Defaults to `guidelines-v1` when unset. Bump (e.g. to
# `guidelines-v2`) before adding a new corpus version so old experiments
# stay comparable.
PINECONE_NAMESPACE=guidelines-v1

# OpenAI — embedding model for both index-time (per chunk) and
# query-time (per `evidenceRetriever` invocation). Pin a billing cap as
# belt-and-suspenders; usage volume is small at MVP corpus size.
OPENAI_API_KEY=

# Cohere — reranker over Pinecone's top-20. Free-trial credits are
# typically sufficient for the W2 sprint.
COHERE_API_KEY=

# Optional override for the Cohere rerank model id. Defaults to
# `rerank-v3.5` (Cohere's current latest English rerank model). Override
# without a code change when Cohere ships a new generation.
COHERE_RERANK_MODEL=rerank-v3.5
