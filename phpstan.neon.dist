includes:
  - .phpstan/phpstan.github.neon

parameters:
  bootstrapFiles:
  - .phpstan/phpstan_panther_alias.php
  - .phpstan/phpstan_include_paths.php
  level: 10
  # Set tmpDir explicitly so we know what it is
  tmpDir: tmp-phpstan
  paths:
  - Documentation
  - _rest_routes.inc.php
  - acl_upgrade.php
  - admin.php
  - apis
  - ccdaservice
  - ccr
  - cli
  - config
  - contrib
  - controller.php
  - controllers
  - custom
  - gacl
  - index.php
  - interface
  - ippf_upgrade.php
  - library
  - oauth2
  - portal
  - setup.php
  - sites
  - sphere
  - sql_patch.php
  - sql_upgrade.php
  - src
  - templates
  - tests
  - version.php
  excludePaths:
    # main_v2.php (T3.1) is a near-verbatim copy of
    # interface/main/tabs/main.php with the lower body block swapped
    # for the dashboard SPA mount. The legacy file has dozens of
    # type-level issues kept in .phpstan/baseline/; rather than
    # duplicate those baseline entries for the copy, we exclude the
    # copy from analysis. The new code we authored (the manifest
    # read + script tag injection) is small and was written under
    # type-aware review. When the dashboard ports the rest of the
    # legacy menu and main_v2.php is rewritten in PHP 8.x style,
    # remove this exclude and lift the file to level 10.
    - interface/main/tabs/main_v2.php
  scanFiles:
  - library/sql.inc.php
  - interface/modules/custom_modules/oe-module-faxsms/.phpstan/SignalWireStubs.php
  # Stubs for legacy constants that are defined at runtime but whose define()
  # calls PHPStan can't follow (dynamic require paths / external PEAR libs).
  # See each stub file's header for what it covers.
  - .phpstan/stubs/postcalendar_constants.php
  - .phpstan/stubs/sasl_constants.php
  # For reasons I can't sort out, using scanDirectories or stubFiles doesn't work here.
  - .phpstan/stubs/pdo_mysql.stub
