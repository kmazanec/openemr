# logs
/logs

# environment vars
.env

# vendor and assets
node_modules
/vendor/*
/public/assets/*
/public/themes/*
!/public/assets/modified
/.docs/.out/*
/.playwright-cli

# ccda service build
ccdaservice/node_modules

# dev editor configs
/.idea/*
/.vscode/*
/.vscode-oss/*
/nbproject/*
.DS_Store
.buildpath
.project
.settings

# testing
.phpunit.result.cache

# dev tool local overrides
phpcs.xml
phpstan.neon
coverage/js-unit

# phpstan
tmp-phpstan/*

# easy dev worktree support
.worktrees.json
docker/development-easy/docker-compose.override.yml
docker/development-easy-light/docker-compose.override.yml
docker/development-easy-redis/docker-compose.override.yml

# AI assistant tooling (per-developer, not project state)
/.agents/
/.claude/*
!/.claude/commands/
/skills-lock.json
/.obsidian

# Local cache for the guideline-corpus fetcher (raw HTML from publishers).
# Committed corpus chunks live in agent/data/corpus/<source>/; the cache is
# the upstream of those chunks and is regenerated by `npm run corpus:fetch:*`.
/agent/.corpus-cache/

# Bbox-debug harness output (PNG overlays + extraction JSONs).
# Regenerated by `tsx agent/scripts/bbox-debug.ts <doc-path>`.
/.bbox-debug/

# QA screenshots taken during local UI verification.
/.qa-screenshots/
