{# Clinical Co-Pilot panel — rendered by public/panel.php.

   Shell-only template. The thread, suggestions rail, and composer are
   populated entirely by `public/js/panel.js` from the SSE stream — PHP
   does not render any briefing content. The data attributes are the
   contract the JS bundle reads; PanelTemplateTest pins them.
#}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ 'Clinical Co-Pilot'|xlt }}</title>
    {{ commonHeader|raw }}
    <link rel="stylesheet" href="{{ cssUrl }}" />
</head>
<body>
    <main class="copilot-panel" data-pid="{{ pid }}" data-site-id="{{ siteId }}" data-proxy-url="{{ proxyUrl }}">
        {# §4.7: history sidebar lists this clinician's prior conversations
           on the active patient. Click → force-resume that thread; the
           composer rebinds to the resumed conversationId so follow-ups
           append. The sentinel at the end of the list drives infinite
           scroll via IntersectionObserver in panel.js. #}
        <aside class="copilot-history" data-role="history">
            <header class="copilot-history__header">
                <h2 class="copilot-history__title">{{ 'History'|xlt }}</h2>
            </header>
            <ul class="copilot-history__list" data-role="history-list"></ul>
            <p class="copilot-history__empty" data-role="history-empty" hidden>
                {{ 'No prior conversations.'|xlt }}
            </p>
            <div class="copilot-history__sentinel" data-role="history-sentinel" hidden></div>
        </aside>
        <section class="copilot-main">
            <header class="copilot-panel__header">
                <h1 class="copilot-panel__title">{{ 'Clinical Co-Pilot'|xlt }}</h1>
                <p class="copilot-panel__subtitle" data-role="status">{{ 'Loading briefing…'|xlt }}</p>
            </header>

            <div class="copilot-thread" data-role="thread"></div>

            <div class="copilot-suggestions" data-role="suggestions" hidden></div>

            {# §D.1 typed-error toast region. The renderer fills this on a
               `pipeline.error` SSE frame, keyed off the error code; the
               element stays in the DOM (with empty body + hidden) when no
               error is active so the JS doesn't have to mint a new node
               under each failure path. role="alert" lets screen readers
               announce the typed message without yanking focus. #}
            <div class="copilot-toast"
                 data-role="upload-toast"
                 role="alert"
                 aria-live="assertive"
                 hidden></div>

            <form class="copilot-composer" data-role="composer">
                <textarea class="copilot-composer__input"
                          data-role="input"
                          name="question"
                          rows="2"
                          maxlength="2000"
                          placeholder="{{ 'Ask a follow-up question about this patient… (Shift+Enter for newline)'|xlt }}"></textarea>
                {# §D.1 file picker. The visible button labels itself with
                   a paperclip glyph; the actual <input type="file"> is
                   visually hidden but kept in the accessibility tree so
                   keyboard + screen-reader users hit the same control.
                   `accept` mirrors the controller's MIME allowlist; the
                   browser respects it as a *hint*, the server still
                   content-sniffs in DocumentUploadController. #}
                <button class="copilot-composer__attach"
                        type="button"
                        data-role="attach"
                        aria-label="{{ 'Attach a document'|xlt }}"
                        title="{{ 'Attach a document'|xlt }}">📎</button>
                <input class="copilot-composer__file"
                       type="file"
                       data-role="file"
                       accept="application/pdf,image/png,image/jpeg,image/tiff" />
                <button class="copilot-composer__submit"
                        type="submit"
                        data-role="submit">{{ 'Ask'|xlt }}</button>
            </form>
        </section>
    </main>

    <script src="{{ jsUrl }}" defer></script>
</body>
</html>
