{% extends "patient/card/card_base.html.twig" %}

{#
    Click handler opens the panel as a peer tab in the OpenEMR shell
    (alongside Calendar, Dashboard, Visit History, etc.) instead of
    replacing the current iframe. `top.navigateTab` reuses the existing
    `copilot` tab if one is already open, navigating it to the new pid
    — that gives the right behavior on patient switch (the existing
    Co-Pilot tab refreshes for the new patient rather than stacking up
    one tab per patient).

    `href` falls through to a same-window navigation only if the tab
    system isn't loaded (e.g. card rendered outside the main tabs UI),
    keeping the link useful in any context.

    Auto-open: when the dashboard renders, prefetch the briefing in a
    background tab so it's already streaming by the time the clinician
    looks at it. If a `copilot` iframe is already mounted on a *different*
    patient (the user switched via the calendar/finder, which doesn't
    re-navigate peer tabs), re-point it at the new pid; if it's already
    on this pid, leave it alone so we don't yank focus or interrupt a
    stream. `top.navigateTab` reuses the existing iframe in both cases —
    we never stack up one tab per patient.
#}
{% block content %}
    <p class="m-0">
        {{ "Open the AI-assisted briefing for the current patient. Every claim is cited back to the chart record it came from."|xlt }}
    </p>
    <p class="mt-2 mb-0">
        <a class="btn btn-primary btn-sm"
           data-role="open-copilot"
           href="{{ panelUrl|attr }}"
           onclick="top.restoreSession(); if (top.navigateTab && top.activateTabByName) { top.navigateTab(this.href, 'copilot', function () { top.activateTabByName('copilot', true); }); return false; }">
            <i class="fa fa-stethoscope"></i>
            {{ "Open Co-Pilot"|xlt }}
        </a>
    </p>
    <script>
        (function () {
            try {
                if (!top || !top.navigateTab) return;
                var panelUrl = {{ panelUrl|json_encode|raw }};
                var existing = top.document.querySelector('iframe[name="copilot"]');
                if (!existing) {
                    top.navigateTab(panelUrl, 'copilot');
                    return;
                }
                // Iframe already mounted. Re-navigate only if it's
                // pointing at a different patient — switching via the
                // calendar/finder doesn't re-nav peer tabs, so the
                // copilot iframe can be stranded on the previous pid.
                // Same-origin access lets us read its URL; if it
                // throws, fall back to navigating (the worst case is
                // a redundant reload of the right patient).
                var sameTarget = false;
                try {
                    var current = existing.contentWindow && existing.contentWindow.location
                        ? existing.contentWindow.location.href
                        : (existing.src || '');
                    sameTarget = current.endsWith(panelUrl)
                        || current.indexOf(panelUrl) !== -1;
                } catch (_) {
                    sameTarget = false;
                }
                if (!sameTarget) {
                    top.navigateTab(panelUrl, 'copilot');
                }
            } catch (e) {
                // Same-origin / DOM access failures are benign here —
                // auto-open is a convenience, not load-bearing.
            }
        })();
    </script>
{% endblock %}
