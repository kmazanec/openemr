# Possible options are prod or dev. No spaces, no quotes.
OPENEMR__ENVIRONMENT=
# Set to true to disable periodic background service execution (Ajax piggybacking).
# Session timeouts and notification badges remain active. Accepts true/1 or false/0.
OPENEMR__NO_BACKGROUND_TASKS=

GITLAB_DEPLOY_TOKEN_NAME=
GITLAB_DEPLOY_TOKEN_VALUE=
SSH_KEY_PATH=
OE_PASS=
MYSQL_ROOT_PASSWORD=
GITLAB_RUNNER_TOKEN=
ANTHROPIC_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true

# DigitalOcean Spaces — raw document storage for the ingestion pipeline (Phase B).
# Spaces is S3-compatible; the agent uses the AWS SDK v3 against a regional
# endpoint computed as https://${SPACES_REGION}.digitaloceanspaces.com. Two IAM
# identities flow through here: OpenEMR (read+write across the bucket) and the
# agent service (read-only on the transient prefix only).

# Bucket name (e.g. cdn.biograph.dev). Single bucket; per-patient prefixing
# happens in code via keyForCanonical(pid, documentUuid, ext).
SPACES_BUCKET=
# Region slug for the Spaces endpoint (nyc3, ams3, sfo3, sgp1, fra1, syd1, etc.).
# The endpoint URL is derived from this — do not put a full URL here.
SPACES_REGION=
# OpenEMR-side IAM key. Policy: s3:GetObject + s3:PutObject + s3:DeleteObject
# scoped to arn:aws:s3:::<bucket>/*. Used to write canonical document bytes
# from a panel upload, and during pipeline runs that bypass the OpenEMR-side
# write route (local dev, tests).
SPACES_OPENEMR_KEY=
SPACES_OPENEMR_SECRET=
# Agent-side IAM key. Policy: s3:GetObject scoped to
# arn:aws:s3:::<bucket>/<SPACES_TRANSIENT_PREFIX>/*. The agent uses this
# identity to mint short-TTL signed-GET URLs for the vision call's image
# inputs and never writes canonical document bytes. The wrapper enforces the
# read-only contract locally as defense in depth even if the cloud-side IAM
# is over-broad.
SPACES_AGENT_KEY=
SPACES_AGENT_SECRET=
# Single-segment prefix (no slashes) for rasterized page images that feed the
# vision call. Defaults to "transient" when unset. The 24h auto-delete
# lifecycle policy on the bucket matches this prefix literally — change it
# only if you also update the lifecycle rule.
SPACES_TRANSIENT_PREFIX=

PINECONE_API_KEY=
PINECONE_INDEX_NAME=
PINECONE_NAMESPACE=

OPENAI_API_KEY=

COHERE_API_KEY=
COHERE_RERANK_MODEL=
