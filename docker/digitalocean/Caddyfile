# Caddy reverse proxy for OpenEMR.
#
# Caddy auto-fetches a Let's Encrypt cert for $OE_DOMAIN on first
# request (the domain's A record must point at this Droplet). It
# terminates TLS at the public edge and forwards to OpenEMR's
# internal :443 over Docker's private network.
#
# `tls_insecure_skip_verify` is on the internal Caddy → openemr hop
# only — the cert OpenEMR's container serves is self-signed and we
# don't validate it because the connection never leaves the Droplet.
# The user-facing cert (real Let's Encrypt) is unaffected.

{$OE_DOMAIN} {
    reverse_proxy openemr:443 {
        transport http {
            tls
            tls_insecure_skip_verify
        }
    }
}

# ---------------------------------------------------------------------------
# Apex landing page (biograph.dev)
# ---------------------------------------------------------------------------
# Static placeholder served from /srv/site, mounted from the host at
# /opt/site. Content lives directly on the Droplet (not in this repo)
# and would need to be re-uploaded after a Droplet rebuild — acceptable
# because it's placeholder content, not load-bearing infrastructure.
{$APEX_DOMAIN} {
    root * /srv/site
    file_server
    encode gzip zstd
}
